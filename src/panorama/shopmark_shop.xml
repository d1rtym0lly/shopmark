<root>
  <styles><include src="s2r://panorama/styles/shopmark_live.vcss_c" /></styles>
  <Panel class="ShopmarkShopSurface" hittest="true">
    <Panel class="ShopmarkShopHeader">
      <Label class="ShopmarkShopKicker" text="SHOPMARK / АВТОПОМОЩНИК" />
      <Label class="ShopmarkShopTitle" text="План покупок" />
      <Label class="ShopmarkShopNote" text="Очередь обновляется по ходу матча. Нажми карточку, чтобы купить предмет." />
    </Panel>
    <Panel id="ShopmarkShopScroll" class="ShopmarkShopScroll">
      <Panel class="ShopmarkShopSection ShopmarkShopSectionNow">
        <Panel class="ShopmarkShopSectionHead"><Label class="ShopmarkShopIndex" text="01" /><Label class="ShopmarkShopHeading" text="Ближайшие покупки" /></Panel>
        <Panel id="ShopmarkShopNow" class="ShopmarkShopGrid" />
      </Panel>
      <Panel class="ShopmarkShopSection">
        <Panel class="ShopmarkShopSectionHead"><Label class="ShopmarkShopIndex" text="02" /><Label class="ShopmarkShopHeading" text="Следующие шаги" /></Panel>
        <Panel id="ShopmarkShopLater" class="ShopmarkShopGrid" />
      </Panel>
      <Panel class="ShopmarkShopSection ShopmarkShopSectionOwned">
        <Panel class="ShopmarkShopSectionHead"><Label class="ShopmarkShopIndex" text="✓" /><Label class="ShopmarkShopHeading" text="Уже куплено" /></Panel>
        <Panel id="ShopmarkShopOwned" class="ShopmarkShopGrid" />
      </Panel>
    </Panel>
    <Panel id="ShopmarkShopCache" class="ShopmarkInventorySource" hittest="false" hittestchildren="false" style="width: 1px; height: 1px; opacity: 0;" />
  </Panel>
</root>
