<root>
  <styles><include src="s2r://panorama/styles/shopmark_live.vcss_c" /></styles>
  <scripts>
    <include src="s2r://panorama/scripts/shopmark_data.vjs_c" />
    <include src="s2r://panorama/scripts/shopmark_coach.vjs_c" />
    <include src="s2r://panorama/scripts/shopmark_live_core.vjs_c" />
    <include src="s2r://panorama/scripts/shopmark_decision.vjs_c" />
    <include src="s2r://panorama/scripts/shopmark_conditions.vjs_c" />
    <include src="s2r://panorama/scripts/shopmark_hud.vjs_c" />
    <include src="s2r://panorama/scripts/shopmark_shop.vjs_c" />
    <include src="s2r://panorama/scripts/shopmark_live.vjs_c" />
  </scripts>
  <Panel class="ShopmarkLiveHost" hittest="false">
    <GlobalClassListener classes="gShopOpen gEditingBuilds gScoreboardOpen" />
    <Panel id="ShopmarkNext" hittest="false" hittestchildren="false">
      <Panel id="ShopmarkNextEdge" />
      <Panel id="ShopmarkNextContent">
        <Panel id="ShopmarkNextFrame"><Image id="ShopmarkNextIcon" /></Panel>
        <Panel id="ShopmarkNextCopy">
          <Label id="ShopmarkNextTag" text="СЛЕДУЮЩАЯ ПОКУПКА" />
          <Label id="ShopmarkNextName" />
          <Label id="ShopmarkNextWhy" />
          <Panel id="ShopmarkNextFooter">
            <Label id="ShopmarkNextPrice" />
            <Label id="ShopmarkNextAvailability" />
          </Panel>
        </Panel>
      </Panel>
    </Panel>
    <Panel id="ShopmarkLiveBox" hittest="true">
      <Button id="ShopmarkAutoToggle">
        <Label id="ShopmarkAutoBrand" text="SHOPMARK / HUD" />
        <Label id="ShopmarkAutoToggleText" text="Автопомощник · выкл" />
      </Button>
      <Panel id="ShopmarkPlacement">
        <Button id="ShopmarkSideToggle"><Label id="ShopmarkSideText" text="Карточка: слева" /></Button>
        <Button id="ShopmarkCompactToggle"><Label id="ShopmarkCompactText" text="Только иконка" /></Button>
      </Panel>
      <Panel id="ShopmarkLiveBody" />
    </Panel>
  </Panel>
</root>
